{
  "name": "ai-todo-desktop",
  "version": "0.2.3",
  "private": true,
  "description": "AI 个性化 ToDo 本地优先桌面应用",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite --config vite.config.ts",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build --config vite.config.ts",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:ui": "playwright test",
    "lint": "oxlint src gateway tests e2e playwright.config.ts",
    "postinstall": "electron-builder install-app-deps",
    "verify": "npm run typecheck && npm test && npm run lint && npm run test:ui",
    "dist:win": "npm run verify && npm run build && electron-builder --win nsis portable --x64 --publish never && node scripts/release-checksums.cjs",
    "pack:win": "npm run build && electron-builder --win --x64 --dir --publish never",
    "test:desktop": "node scripts/smoke-desktop.cjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.4.1",
    "hono": "^4.9.7",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.76.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.aitodo.desktop",
    "productName": "AI ToDo",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false,
      "artifactName": "AI-ToDo-${version}-${arch}-nsis.${ext}"
    },
    "portable": {
      "artifactName": "AI-ToDo-${version}-${arch}-portable.${ext}"
    }
  },
  "author": "AI ToDo"
}
